# Verifier backend: "auto" (default, uses Jev if key present, else AgentGround), "jev", or "agentground"
VERIFIER_BACKEND=auto

# Typesafe Jev API key (optional if using AgentGround open verifier)
TYPESAFE_API_KEY=

# AgentGround open claim verification service (zero-key mode)
AGENTGROUND_URL=https://agentground.atlether.trade/api/v1/verify-claims
